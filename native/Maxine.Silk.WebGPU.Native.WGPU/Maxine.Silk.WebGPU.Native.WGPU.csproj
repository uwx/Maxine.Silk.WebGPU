<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net4.6.1</TargetFrameworks>
        <Authors>.NET Foundation and Contributors</Authors>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/uwx/Maxine.Silk.WebGPU</PackageProjectUrl>
        <Description>Native wgpu-native library backing Maxine.Silk.WebGPU.</Description>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/gfx-rs/wgpu-native</RepositoryUrl>
        <WgpuNativeVersion>v29.0.1.1</WgpuNativeVersion>
    </PropertyGroup>

    <!-- The default item globs would claim these as @(None). They are handed to the consumer through
         @(Content) instead, below, and an item in both would be copied twice. -->
    <ItemGroup>
        <None Remove="runtimes\**\*" />
    </ItemGroup>

    <!-- The nupkg layout (runtimes/<rid>/native) is what NuGet's own RID resolution reads, so a
         PackageReference consumer needs nothing from the target below. Re-added here because the
         Remove above takes the default glob, which is also what pack would have gathered.

         Spelled out per file rather than globbed: packing a glob's RecursiveDir alongside the
         item's own TargetPath puts each library two directories deep
         (runtimes/win-x64/native/win-x64/native/wgpu_native.dll), and pack ignores TargetPath when
         PackagePath is overridden this way. -->
    <ItemGroup>
        <None Include="runtimes\win-x64\native\wgpu_native.dll" Pack="true" PackagePath="runtimes/win-x64/native" Visible="false" />
        <None Include="runtimes\win-x86\native\wgpu_native.dll" Pack="true" PackagePath="runtimes/win-x86/native" Visible="false" />
        <None Include="runtimes\win-arm64\native\wgpu_native.dll" Pack="true" PackagePath="runtimes/win-arm64/native" Visible="false" />
        <None Include="runtimes\linux-x64\native\libwgpu_native.so" Pack="true" PackagePath="runtimes/linux-x64/native" Visible="false" />
        <None Include="runtimes\linux-arm64\native\libwgpu_native.so" Pack="true" PackagePath="runtimes/linux-arm64/native" Visible="false" />
        <None Include="runtimes\osx-x64\native\libwgpu_native.dylib" Pack="true" PackagePath="runtimes/osx-x64/native" Visible="false" />
        <None Include="runtimes\osx-arm64\native\libwgpu_native.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native" Visible="false" />
    </ItemGroup>

    <!--
        The wgpu-native libraries, handed to whatever consumes this project.

        This project produces no assembly - it is the binaries plus a copy step. A ProjectReference
        to it therefore carries nothing by default, because a project reference passes along an
        assembly and that assembly's copy-to-output items; with no assembly and the libraries laid
        out under runtimes/, NuGet's convention rather than MSBuild's, the consumer got nothing.
        The Content items below are what makes the reference functional rather than merely valid:
        they carry the CopyToOutputDirectory that schedules the copy and the Link that puts the file
        in the consumer's output root.

        Flat in the root rather than under runtimes/<rid>/native/, because that is where a loader
        looks for a bare library name. NuGet's own RID handling, which does use that layout, only
        applies to a RID-specific build of the consumer, and this consumer is RID-less;
        WebGPULibraryNameContainer asks for "wgpu_native" by name.

        It has to run inside a target, because neither of the two things it needs exists earlier.
        @(Content) is read by AssignTargetPaths as it builds @(ContentWithTargetPath), so adding to
        it at evaluation time is not enough. $(RuntimeIdentifier) is the other: a ProjectReference
        is resolved with its properties already set, so the RID the consumer asked for does reach
        this project, but not before evaluation.
    -->
    <Target Name="WgpuNativeLayout" BeforeTargets="AssignTargetPaths">
        <PropertyGroup>
            <!-- A build that named a RID means it - but it cannot be read from $(RuntimeIdentifier)
                 here. When the SDK collects a project's copy-to-output items it invokes the project
                 with the RID stripped from its properties, so a consumer's -r linux-x64 arrives as
                 an empty RuntimeIdentifier and this project would fall back to the host and copy
                 Windows DLLs into a linux-x64 output directory. Measured, not assumed: under
                 -r linux-x64 both RuntimeIdentifier and the host are visible here and only the
                 latter has a value. RuntimeIdentifier stays as a fallback for a direct reference to
                 this project, and the consumer passes WgpuNativeRid to say what it is targeting.

                 NETCoreSdkRuntimeIdentifier is the last fallback and describes the machine doing the
                 build, which is the best available answer: a RID-less build is one for the host, and
                 that is the only platform it can be built for. A RID outside the set matches nothing
                 and so copies nothing, which is the honest outcome when there are no binaries for
                 it. -->
            <_WgpuNativeRid Condition="'$(_WgpuNativeRid)' == ''">$(WgpuNativeRid)</_WgpuNativeRid>
            <_WgpuNativeRid Condition="'$(_WgpuNativeRid)' == ''">$(RuntimeIdentifier)</_WgpuNativeRid>
            <_WgpuNativeRid Condition="'$(_WgpuNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_WgpuNativeRid>

            <!-- Read off the RID directory rather than from RuntimeInformation, which would describe
                 the machine doing the build and so answer for the wrong platform on a cross-targeted
                 one. -->
            <_WgpuNativeName Condition="$(_WgpuNativeRid.StartsWith('win'))">wgpu_native.dll</_WgpuNativeName>
            <_WgpuNativeName Condition="$(_WgpuNativeRid.StartsWith('linux'))">libwgpu_native.so</_WgpuNativeName>
            <_WgpuNativeName Condition="$(_WgpuNativeRid.StartsWith('osx'))">libwgpu_native.dylib</_WgpuNativeName>
        </PropertyGroup>

        <ItemGroup>
            <!-- Exists() guards the item, because a missing Include here is not a skipped copy but
                 MSB3030, which fails the consumer's build. -->
            <Content Include="runtimes\$(_WgpuNativeRid)\native\$(_WgpuNativeName)" Condition="'$(_WgpuNativeRid)' != '' And Exists('runtimes\$(_WgpuNativeRid)\native\$(_WgpuNativeName)')">
                <Link>$(_WgpuNativeName)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <Visible>false</Visible>
            </Content>
        </ItemGroup>
    </Target>
</Project>
